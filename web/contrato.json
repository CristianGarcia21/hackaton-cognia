  "schema": {
    "cliente": {
      "$defs": {
        "Start": {
          "additionalProperties": false,
          "description": "Empieza a capturar el micrófono; desde aquí llegan frames binarios de audio.",
          "examples": [
            {
              "type": "start"
            }
          ],
          "properties": {
            "type": {
              "const": "start",
              "default": "start",
              "title": "Type",
              "type": "string"
            }
          },
          "title": "Start",
          "type": "object"
        },
        "Stop": {
          "additionalProperties": false,
          "description": "Deja de capturar el micrófono.",
          "examples": [
            {
              "type": "stop"
            }
          ],
          "properties": {
            "type": {
              "const": "stop",
              "default": "stop",
              "title": "Type",
              "type": "string"
            }
          },
          "title": "Stop",
          "type": "object"
        },
        "TextInput": {
          "additionalProperties": false,
          "description": "Respaldo por texto o pregunta sugerida pulsada: se procesa como si el usuario la hubiera dicho.\nSe quitan los espacios de los extremos y se recorta a 2000 caracteres; vacío → inválido.",
          "examples": [
            {
              "text": "¿Qué IPS tienen sala de cirugía en Medellín?",
              "type": "text_input"
            }
          ],
          "properties": {
            "type": {
              "const": "text_input",
              "default": "text_input",
              "title": "Type",
              "type": "string"
            },
            "text": {
              "minLength": 1,
              "title": "Text",
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "title": "TextInput",
          "type": "object"
        }
      },
      "discriminator": {
        "mapping": {
          "start": "#/$defs/Start",
          "stop": "#/$defs/Stop",
          "text_input": "#/$defs/TextInput"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Start"
        },
        {
          "$ref": "#/$defs/Stop"
        },
        {
          "$ref": "#/$defs/TextInput"
        }
      ]
    },
