# Copia este archivo a .env y llena las keys que tengas. Las vacías se ignoran.

# Gemini (principal) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gratis / free tier
GROQ_API_KEY=          # https://console.groq.com/keys      (muy rápido)
OPENROUTER_API_KEY=    # https://openrouter.ai/keys          (modelos ":free")
NVIDIA_NIM_API_KEY=    # https://build.nvidia.com            (gratis, muchos modelos)
COHERE_API_KEY=        # https://dashboard.cohere.com/api-keys (trial key gratis)
CEREBRAS_API_KEY=      # https://cloud.cerebras.ai           (elige "Limited Credits")
MISTRAL_API_KEY=       # https://console.mistral.ai/api-keys

# Opcional: forzar modelo principal y orden de fallback (formato LiteLLM)
# DEFAULT_MODEL=gemini/gemini-3.5-flash
# FALLBACK_MODELS=gemini/gemini-3.5-flash,groq/openai/gpt-oss-120b,cohere/command-a-plus-05-2026
# EMBED_MODEL=gemini/gemini-embedding-001

# ===== Reto: Agente Vocal Cognitivo =====
# Voz (STT + diarización + TTS) — https://console.deepgram.com → API Keys
DEEPGRAM_API_KEY=
# Datos de IPS — datos.gov.co → Portal del desarrollador → API Keys (id + secreto, auth Basic en SODA3)
DATOS_GOV_KEY_ID=
DATOS_GOV_KEY_SECRET=
# Opcional: voz del agente (Aura-2 en español)
# VOICE_MODEL=aura-2-celeste-es
# Opcional: segunda cuenta de Groq como respaldo del LLM de voz (si no, respalda gpt-4o-mini de Deepgram)
GROQ_API_KEY_2=
